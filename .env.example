# ---- M6.3 MCP 服务器（可选；JSON 列表，可多个；不可达不阻断启动）----
# 示例（Obsidian Local REST API 插件，启用 MCP server 后）：
# MCP_SERVERS=[{"serverName":"obsidian","url":"http://127.0.0.1:27123/mcp/","headers":{"Authorization":"Bearer <API_KEY>"},"prefix":"obsidian"}]
MCP_SERVERS=

# ---- M7.1 LLM provider（WO-20260816-41）：ollama（本地，默认）| openai（云端）----
# 切换 openai 后，文本与工具调用均走 OPENAI_BASE_URL 的 /chat/completions（DeepSeek/OpenAI 兼容）。
# API key 只从环境变量/.env 读取，绝不提交到 git 或写入日志。
LLM_PROVIDER=ollama
# 云端默认 DeepSeek 端点（实测可达；如需 OpenAI 官方改 https://api.openai.com/v1）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 在 .env（gitignored）里填真实 key；.env.example 只留占位符
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
